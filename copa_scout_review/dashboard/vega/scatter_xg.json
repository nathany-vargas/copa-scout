{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "xG Criado vs xG Sofrido — Copa 2022",
  "width": 500,
  "height": 400,
  "autosize": "none",
  "data": {
    "url": {
      "index": "match_stats",
      "body": {
        "size": 300,
        "_source": ["team", "opponent", "xg_for", "xg_against", "match_id", "stage"],
        "query": {
          "term": {"tournament": "FIFA World Cup 2022"}
        }
      }
    },
    "format": {"property": "hits.hits"}
  },
  "transform": [
    {"calculate": "datum._source.xg_for", "as": "xG Criado"},
    {"calculate": "datum._source.xg_against", "as": "xG Sofrido"},
    {"calculate": "datum._source.team", "as": "Seleção"},
    {"calculate": "datum._source.opponent", "as": "Adversário"},
    {"calculate": "datum._source.stage", "as": "Fase"}
  ],
  "mark": {"type": "circle", "opacity": 0.7, "size": 100},
  "encoding": {
    "x": {
      "field": "xG Criado",
      "type": "quantitative",
      "scale": {"domain": [0, 6]},
      "title": "xG Criado (ataque)"
    },
    "y": {
      "field": "xG Sofrido",
      "type": "quantitative",
      "scale": {"domain": [0, 6]},
      "title": "xG Sofrido (defesa)"
    },
    "color": {
      "field": "Seleção",
      "type": "nominal",
      "legend": null
    },
    "tooltip": [
      {"field": "Seleção"},
      {"field": "Adversário"},
      {"field": "xG Criado", "format": ".2f"},
      {"field": "xG Sofrido", "format": ".2f"},
      {"field": "Fase"}
    ]
  }
}
